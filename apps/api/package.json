    "@hono/zod-validator": "^0.2.2",
    "@react-pdf/renderer": "^3.4.4",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.11",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.4",
    "react": "^19.2.8",

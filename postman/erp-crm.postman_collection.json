{
  "info": {
    "name": "Mini ERP + CRM API",
    "description": "Full API collection for the wholesale/distribution ERP+CRM portal. Set the collection variable base_url and login first to populate access_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "challan_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@erp.test\",\n  \"password\": \"Passw0rd!\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh token",
          "request": { "method": "POST", "url": "{{base_url}}/auth/refresh" }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/me"
          }
        },
        { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/auth/logout" } }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/customers?page=1&limit=20"
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"mobile\": \"9999999999\",\n  \"businessName\": \"Test Traders\",\n  \"customerType\": \"retail\",\n  \"address\": \"Test address\",\n  \"status\": \"lead\"\n}" },
            "url": "{{base_url}}/customers"
          }
        },
        {
          "name": "Get customer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/customers/{{customer_id}}"
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\"\n}" },
            "url": "{{base_url}}/customers/{{customer_id}}"
          }
        },
        {
          "name": "Add follow-up note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Called customer, will follow up next week\"\n}" },
            "url": "{{base_url}}/customers/{{customer_id}}/notes"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/products?page=1&limit=20"
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Product\",\n  \"sku\": \"SKU-TEST-1\",\n  \"category\": \"Hardware\",\n  \"unitPrice\": 100,\n  \"currentStock\": 50,\n  \"minStockAlert\": 10\n}" },
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "Adjust stock (manual)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantityChanged\": 10,\n  \"movementType\": \"IN\",\n  \"reason\": \"Purchase Order #1\"\n}" },
            "url": "{{base_url}}/products/{{product_id}}/movements"
          }
        },
        {
          "name": "Get stock movements",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/products/{{product_id}}/movements"
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "Create draft challan",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('challan_id', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"items\": [{ \"productId\": \"{{product_id}}\", \"quantity\": 5 }]\n}" },
            "url": "{{base_url}}/challans"
          }
        },
        {
          "name": "Confirm challan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/challans/{{challan_id}}/confirm"
          }
        },
        {
          "name": "Cancel challan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/challans/{{challan_id}}/cancel"
          }
        },
        {
          "name": "Export challan PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/challans/{{challan_id}}/pdf"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/dashboard/summary"
          }
        }
      ]
    }
  ]
}
